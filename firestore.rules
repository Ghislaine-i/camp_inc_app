rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function aluEmail() {
      return signedIn() &&
        request.auth.token.email.matches('.*@(alustudent|alueducation)[.]com');
    }
    function verified() {
      return aluEmail() && request.auth.token.email_verified == true;
    }
    function isStaff() {
      return verified() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    match /users/{uid} {
      allow read: if aluEmail();
      allow create: if aluEmail()
        && request.auth.uid == uid
        && request.resource.data.role == 'student';
      allow update: if verified()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if verified();
      allow create: if verified()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'lastNote']);
      allow delete: if false;

      match /statusHistory/{eventId} {
        allow read: if verified();
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }
  }
}